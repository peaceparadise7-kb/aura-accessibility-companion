# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files
*.dart text eol=lf
*.kt text eol=lf
*.swift text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.onnx binary
*.tflite binary
*.ico binary
